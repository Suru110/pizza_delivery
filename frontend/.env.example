# Frontend Environment Variables (Vercel)
# Copy these into Vercel → Project Settings → Environment Variables

# URL of your deployed Render backend (no trailing slash, include /api)
VITE_API_URL=https://your-backend-name.onrender.com/api

# URL of your deployed Render backend (for WebSocket connection, no /api suffix)
VITE_SOCKET_URL=https://your-backend-name.onrender.com
